# Copy to .env and replace placeholder values. Never commit .env or real credentials.

# OpenAI-compatible chat and embedding API.
SemanticKernelOptions__ChatProviderType=OpenAI
SemanticKernelOptions__EmbeddingProviderType=OpenAI
SemanticKernelOptions__ChatEndpoint=https://api.example.com/v1
SemanticKernelOptions__EmbeddingEndpoint=https://api.example.com/v1
SemanticKernelOptions__ChatApiKey=replace-with-api-key
SemanticKernelOptions__EmbeddingApiKey=replace-with-api-key
SemanticKernelOptions__ChatDeploymentName=your-chat-model
SemanticKernelOptions__ChatModel=your-chat-model
SemanticKernelOptions__EmbeddingDeploymentName=your-embedding-model
SemanticKernelOptions__EmbeddingModel=your-embedding-model
SemanticKernelOptions__Temperature=0.2
SemanticKernelOptions__SearchThreshold=0.4
SemanticKernelOptions__MaximumInvocationCount=10

# Local service URLs used by integration tests.
GENAI_TEST_CATALOGS_BASE_URL=http://localhost:5000
GENAI_TEST_CARTS_BASE_URL=http://localhost:4000
GENAI_TEST_ORDERS_BASE_URL=http://localhost:7000
GENAI_TEST_RECOMMENDATION_BASE_URL=http://localhost:2000
GENAI_TEST_REVIEWS_BASE_URL=http://localhost:8000
GENAI_TEST_MCP_BASE_URL=http://localhost:9000